# ── Model ────────────────────────────────────────────────────────────────────
# Vertex AI:  GOOGLE_GENAI_USE_VERTEXAI=TRUE + GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION
# AI Studio:  GOOGLE_API_KEY=...
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-2.5-flash
# EXPLORER_MODEL_NAME=gemini-2.5-flash
# REGENERATION_MODEL_NAME=gemini-2.5-flash
GROUNDING_REGENERATE=true

# ── Semantic layer (the client's knowledge) ──────────────────────────────────
# yaml for local dev/tests, bigquery for production
SEMANTIC_BACKEND=yaml
SEMANTIC_YAML_DIR=semantic_layer/demo
# SEMANTIC_BACKEND=bigquery
# BQ_PROJECT=your-gcp-project
# BQ_DATASET=fpa_semantic_layer
# BQ_TABLE_PREFIX=sl_

# ── Sources: one env var per sl_sources.connection.*_env ─────────────────────
# Production (generic MCP server per source):
# ERP_MCP_URL=https://erp-mcp.example.com/mcp
# AGENT_SA_KEY_SECRET=projects/your-gcp-project/secrets/agent-sa-key/versions/latest
# Demo (local sqlite; defaults to demo/data/*.sqlite):
# DEMO_SIS_DB=demo/data/sis.sqlite
# DEMO_ERP_DB=demo/data/erp.sqlite

# ── Audit trail ──────────────────────────────────────────────────────────────
# TURN_LOG_GCS_BUCKET=your-audit-bucket       (else logs/turns/*.jsonl)
